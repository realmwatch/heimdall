<!-- A cut-down copy of nginx.org's xml/en/security_advisories.xml, in its format. -->
<!DOCTYPE article SYSTEM "../../dtd/article.dtd">

<article name="nginx security advisories"
         link="/en/security_advisories.html"
         lang="en"
         rev="1">

<section>

<para>
All nginx security issues should be reported &mdash; see
<link url="https://example.com/">here</link>.
</para>

<security>

